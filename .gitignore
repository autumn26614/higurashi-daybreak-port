# Allow-list: only these top-level entries are tracked. Everything else in this folder
# (the original game, the Kai expansion disc, the fan translation, analysis notes)
# stays on this PC only.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/port/
# To also publish the reverse-engineering notes, uncomment:
# !/analysis/

# Belt and braces inside port/: no game archives or binaries, only the synthetic fixture.
*.dat
!/port/ios/Fixtures/fixture.dat
!/port/ios/Fixtures/fixture-overlay.dat
*.exe
*.dll

# Build output and generated projects
/port/build/
/port/ios/*.xcodeproj/
/port/ios/DaybreakStageViewer/Info.plist
DerivedData/
*.xcresult
__pycache__/
